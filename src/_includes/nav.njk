{#- The header on every page but the home page, which has its own: the app icon, linking home, and the links. -#}
<header class="mx-auto flex w-full max-w-5xl items-start justify-between gap-6 px-6 pt-10">
  <a href="/" class="shrink-0 rounded-[9px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink">
    <img src="/images/app-icon.png" srcset="/images/app-icon.png 1x, /images/app-icon@2x.png 2x" width="40" height="40" alt="{{ site.name }} home" class="size-10 rounded-[9px]">
  </a>

  {% include "nav-links.njk" %}
</header>
