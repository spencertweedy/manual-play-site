{#- The links at the top right of every page. -#}
{%- set navLinks = [
  { label: "Features", href: "/#features" },
  { label: "Support", href: "/support/" },
  { label: "Contact", href: "mailto:" + site.email + "?subject=Message%20about%20Manual%20Play" }
] -%}
<nav aria-label="Main">
  <ul class="flex flex-wrap justify-end gap-x-5 gap-y-2 text-sm font-medium">
    {%- for link in navLinks %}
    <li><a href="{{ link.href }}" class="text-ink/75 hover:text-ink"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
    {%- endfor %}
  </ul>
</nav>
